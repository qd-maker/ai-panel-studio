# 复制为 .env 后按需修改。启动：uvicorn app.main:create_app --factory --env-file .env
# mock：用 FakeLLM，不联网、不花钱；deepseek：调用 DeepSeek
LLM_MODE=mock

# 只在 LLM_MODE=deepseek 时需要。Key 只从环境变量读取，不要写进代码和前端
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 两条发言之间的停顿（秒）和专家发言轮数上限
TURN_DELAY_S=1.5
MAX_EXPERT_TURNS=12

# 线上演示的访问保护：设置 APP_PASSWORD 后进站要输密码；每日上限保护模型额度（0 表示不限）
APP_PASSWORD=
APP_SECRET=
COOKIE_SECURE=false
MAX_STARTS_PER_DAY=0
MAX_CREATES_PER_DAY=0

# 单条 SSE 连接最长存活秒数，到时服务端断开、浏览器带 Last-Event-ID 续传；0 表示不限制
SSE_MAX_STREAM_S=0
